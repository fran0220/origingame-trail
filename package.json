{
  "name": "origingame-trail",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "First-person jungle trail. Procedural everything, zero external assets, and a notebook to fill. Fork of StarKnightt/jungle-trail.",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "shoot": "node tools/shoot.mjs",
    "pack": "node tools/pack.mjs",
    "test": "node tools/smoke.mjs && node tools/journey.mjs && node tools/save-roundtrip.mjs",
    "test:smoke": "node tools/smoke.mjs",
    "test:lake": "node tools/lake-truth.mjs",
    "test:picker": "node tools/scene-picker.mjs",
    "test:cold": "node tools/cold-start.mjs",
    "test:movement": "node tools/movement.mjs",
    "test:water-bed": "node tools/water-bed.mjs",
    "test:journey": "node tools/journey.mjs",
    "test:save": "node tools/save-roundtrip.mjs",
    "test:map": "node tools/map-truth.mjs",
    "test:quality": "node tools/quality.mjs",
    "gallery": "node tools/gallery.mjs",
    "shots": "node tools/shots.mjs",
    "cover": "node tools/cover.mjs",
    "test:brook": "node tools/brook-edge.mjs",
    "deploy:check": "node tools/pack.mjs && node tools/deploy-check.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fran0220/origingame-trail.git"
  }
}
