node_modules/

# Tool output: several hundred captures, atlas dumps and offline WAV renders.
# Over a gigabyte, and all of it reproducible from tools/.
shots/

# Deployable output. `npm run pack` rebuilds it from index.html, src/ and
# vendor/ in under a second; there is nothing in it that is not already here.
dist/

# Throwaway scratch scripts and their output.
tmp-*

npm-debug.log*
.DS_Store
Thumbs.db
.env
.env.*

# Smoke-test frame, rewritten on every run.
media/smoke.png

# Gallery working runs. Regenerated in a minute by tools/gallery.mjs, and
# machine-specific: these are software-rendered here and would differ on a
# real GPU. Only the milestone metrics.json is worth keeping, so the images
# under a baseline are ignored and the numbers beside them are not.
media/iter-*/
media/base-*/*.jpg
